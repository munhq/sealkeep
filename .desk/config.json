{
  "version": 1,
  "github": "munhq/sealkeep",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "root",
      "command": "sh .desk/workflows/buck-base/scripts/buck-run.sh build //:check //:test-runs",
      "timeoutMinutes": 30
    },
    {
      "name": "lint",
      "command": "sh .desk/workflows/buck-rust/scripts/clippy.sh",
      "stage": "main",
      "timeoutMinutes": 20
    },
    {
      "name": "format",
      "command": "sh .desk/workflows/buck-rust/scripts/fmt.sh",
      "stage": "land",
      "timeoutMinutes": 10
    },
    {
      "name": "release-macos",
      "command": "macos-release.sh sealkeep com.munhq.sealkeep dist/macos && for f in dist/macos/*; do rcodesign print-signature-info \"$f\" | grep -E 'identifier|team_name|signed_with|time_stamp|runtime' ; done && (cd dist/macos && sha256sum sealkeep-darwin-* > SHA256SUMS-macos && cat SHA256SUMS-macos)",
      "paths": [
        "Cargo.toml",
        ".desk/config.json"
      ],
      "stage": "main",
      "timeoutMinutes": 60,
      "artifacts": [
        "dist/macos/*"
      ],
      "secrets": {
        "APPLE_P12": "apple_p12",
        "APPLE_P12_PASSWORD": "apple_p12_password",
        "ASC_KEY_P8": "asc_key_p8",
        "ASC_KEY_ID": "asc_key_id",
        "ASC_ISSUER_ID": "asc_issuer_id"
      }
    },
    {
      "name": "release-linux-windows",
      "command": "release-build.sh sealkeep dist/release",
      "paths": [
        "Cargo.toml",
        ".desk/config.json"
      ],
      "stage": "main",
      "timeoutMinutes": 60,
      "artifacts": [
        "dist/release/*"
      ],
      "secrets": {
        "COSIGN_KEY": "cosign_key",
        "COSIGN_PASSWORD": "cosign_password"
      }
    }
  ],
  "release": {
    "versionFile": "Cargo.toml",
    "tagPrefix": "v"
  },
  "preLand": [],
  "checkouts": [
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-base",
      "at": 613,
      "subpath": "workflows/buck-base"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-rust",
      "at": 613,
      "subpath": "workflows/buck-rust"
    }
  ]
}
