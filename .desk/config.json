{
  "version": 1,
  "github": "munhq/sealkeep",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "fmt",
      "command": "cargo fmt --check",
      "paths": [
        "src/**",
        "tests/**"
      ],
      "timeoutMinutes": 10
    },
    {
      "name": "clippy",
      "command": "cargo clippy --locked --all-targets --features test-store -- -D warnings",
      "paths": [
        "src/**",
        "tests/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "timeoutMinutes": 20
    },
    {
      "name": "test",
      "command": "cargo test --locked --features test-store",
      "paths": [
        "src/**",
        "tests/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "timeoutMinutes": 20
    },
    {
      "name": "release-macos",
      "command": "macos-release.sh sealkeep com.munhq.sealkeep dist/macos && for f in dist/macos/*; do rcodesign print-signature-info \"$f\" | grep -E 'identifier|team_name|signed_with|time_stamp|runtime' ; done && (cd dist/macos && sha256sum sealkeep-darwin-* > SHA256SUMS && cat SHA256SUMS)",
      "paths": [
        "Cargo.toml",
        ".desk/config.json"
      ],
      "stage": "main",
      "timeoutMinutes": 120,
      "secrets": {
        "APPLE_P12": "apple_p12",
        "APPLE_P12_PASSWORD": "apple_p12_password",
        "ASC_KEY_P8": "asc_key_p8",
        "ASC_KEY_ID": "asc_key_id",
        "ASC_ISSUER_ID": "asc_issuer_id"
      }
    }
  ]
}
