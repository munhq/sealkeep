{
  "version": 1,
  "github": "munhq/sealkeep",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "format",
      "command": "cargo fmt --check",
      "stage": "land",
      "paths": [
        "**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        "rustfmt.toml",
        ".rustfmt.toml"
      ]
    },
    {
      "name": "fmt",
      "command": "cargo fmt --check",
      "paths": [
        "src/**",
        "tests/**"
      ],
      "timeoutMinutes": 10
    },
    {
      "name": "clippy",
      "command": "cargo clippy --locked --all-targets --features test-store -- -D warnings",
      "paths": [
        "src/**",
        "tests/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "timeoutMinutes": 20
    },
    {
      "name": "test",
      "command": "cargo test --locked --features test-store",
      "paths": [
        "src/**",
        "tests/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "timeoutMinutes": 20
    },
    {
      "name": "release-macos",
      "command": "macos-release.sh sealkeep com.munhq.sealkeep dist/macos && for f in dist/macos/*; do rcodesign print-signature-info \"$f\" | grep -E 'identifier|team_name|signed_with|time_stamp|runtime' ; done && (cd dist/macos && sha256sum sealkeep-darwin-* > SHA256SUMS-macos && cat SHA256SUMS-macos)",
      "paths": [
        "Cargo.toml",
        ".desk/config.json"
      ],
      "stage": "main",
      "timeoutMinutes": 60,
      "artifacts": [
        "dist/macos/*"
      ],
      "secrets": {
        "APPLE_P12": "apple_p12",
        "APPLE_P12_PASSWORD": "apple_p12_password",
        "ASC_KEY_P8": "asc_key_p8",
        "ASC_KEY_ID": "asc_key_id",
        "ASC_ISSUER_ID": "asc_issuer_id"
      }
    },
    {
      "name": "release-linux-windows",
      "command": "release-build.sh sealkeep dist/release",
      "paths": [
        "Cargo.toml",
        ".desk/config.json"
      ],
      "stage": "main",
      "timeoutMinutes": 60,
      "artifacts": [
        "dist/release/*"
      ],
      "secrets": {
        "COSIGN_KEY": "cosign_key",
        "COSIGN_PASSWORD": "cosign_password"
      }
    }
  ],
  "release": {
    "versionFile": "Cargo.toml",
    "tagPrefix": "v"
  }
}
