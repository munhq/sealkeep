# Buck2 builds and tests this repository (munhq/desk#97, docs/runs.md of desk): each action declares its inputs, so
# NativeLink serves the result of an action whose inputs did not change. The remote cache is NativeLink: a runner
# passes its address with -c buck2_re_client.*_address=... and -c desk.remote_cache=true (scripts/check.sh).
[cells]
root = .
prelude = prelude
toolchains = .desk/workflows/buck-base/toolchains
desk_platforms = .desk/workflows/buck-base/platforms
desk_rust = .desk/workflows/buck-rust
none = none

[cell_aliases]
config = prelude
fbcode = none
fbsource = none
buck = none

[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

[build]
execution_platforms = desk_platforms//:platforms

[buck2_re_client]
tls = false
instance_name = main

[project]
ignore = .git, target, node_modules, buck-out, .desk-work
